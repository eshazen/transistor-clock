# KiCad 10 Recommended Gitignore

.history/

# --- Temporary & Backup Files ---
*.log
*.raw
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb

# --- Local User Settings ---
# These contain local paths and window positions
fp-info-cache
*.kicad_prl

# --- Derived/Output Files ---
# Optional: Ignore these if you want to regenerate them from source
*.net
*.xml
*.csv
*.job
*.gbr
*.drl
*.pdf
# Documentation and Gerbers are often better managed via Releases
/plots/
/gerbers/

# --- Project Specific ---
# Ignore the local project-specific library table if it contains absolute paths
# fp-lib-table
# sym-lib-table


_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local project settings
*.kicad_prl
